# Vercel Deployment
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/toolnest
POSTGRES_USER=toolnest_user
POSTGRES_PASSWORD=your_secure_password

# Redis Cache
REDIS_URL=redis://localhost:6379

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=toolnest-files

# AI Provider (OpenAI/Gemini)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET_KEY=your_razorpay_secret_key

# Analytics
ANALYTICS_PROVIDER=vercel_analytics
GOOGLE_ANALYTICS_ID=UA-your-id-here

# AdSense
ADSENSE_CLIENT_ID=ca-pub-your-adsense-id

# Environment
NODE_ENV=production
NEXT_PUBLIC_DOMAIN=https://example.com
